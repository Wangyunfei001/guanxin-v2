classDiagram
    class SSEEvent {
        +type: 'token' | 'reasoning' | 'tool_call' | 'tool_result' | 'a2ui' | 'done' | 'error'
        +content?: string
        +tool_name?: string
        +tool_input?: string
        +tool_output?: string
        +schema?: A2UISchema
    }

    class A2UISchema {
        +component_type: string
        +props: Record~string, any~
        +children?: A2UISchema[]
    }

    class ChatMessage {
        +role: 'user' | 'assistant' | 'system' | 'tool'
        +content: string
        +reasoning?: string
        +toolCalls?: ToolCall[]
        +a2uiSchemas?: A2UISchema[]
        +streaming?: boolean
    }

    class ToolCall {
        +name: string
        +input: string
        +output?: string
    }

    class User {
        +user_id: string
        +username: string
        +tenant_id: string
        +tenant_name: string
        +role: 'admin' | 'user'
        +display_name: string
        +created_at: string
    }

    class Conversation {
        +conversation_id: string
        +title: string
        +agent_id: string
        +created_at: string
        +updated_at: string
        +message_count?: number
    }

    class Document {
        +doc_id: string
        +tenant_id: string
        +filename: string
        +file_type: string
        +file_size: number
        +title: string
        +status: string
        +chunk_count: number
        +error_message: string
        +created_at: string
        +updated_at: string
    }

    class RetrievalResult {
        +chunk_id: string
        +content: string
        +score: number
        +doc_id: string
        +filename: string
    }

    class SkillMetadata {
        +name: string
        +display_name: string
        +description: string
        +skill_type: string
        +status: string
        +version: string
        +params: SkillParam[]
        +tags: string[]
        +category: string
    }

    class MCPServer {
        +name: string
        +command: string
        +args: string[]
        +env: Record~string, string~
        +description: string
        +status: string
    }

    class ApiResponse~T~ {
        +code: number
        +message: string
        +data: T
    }

    ChatMessage *-- ToolCall : toolCalls[]
    ChatMessage *-- A2UISchema : a2uiSchemas[]
    SSEEvent ..> A2UISchema : schema

    class AuthStore {
        +token: string
        +user: User | null
        +isLoggedIn: boolean
        +isAdmin: boolean
        +login(username, password) Promise
        +logout() void
        +fetchMe() Promise
    }

    class ChatStore {
        +conversations: Conversation[]
        +currentConversationId: string
        +messages: ChatMessage[]
        +loading: boolean
        +loadConversations() Promise
        +createConversation(title) Promise
        +sendMessage(text) Promise
        +selectConversation(id) Promise
        +clearMessages() void
        +deleteConversation(id) Promise
    }

    class KnowledgeStore {
        +documents: Document[]
        +chunks: any[]
        +retrievalResults: RetrievalResult[]
        +loading: boolean
        +loadDocuments() Promise
        +uploadDocument(file, title) Promise
        +deleteDocument(id) Promise
        +retrieve(query, topK) Promise
    }

    class SkillStore {
        +skills: SkillMetadata[]
        +loading: boolean
        +loadSkills() Promise
        +executeSkill(name, params) Promise
    }

    class AgentStore {
        +skills: SkillMetadata[]
        +loading: boolean
        +loadSkills() Promise
    }

    class McpStore {
        +servers: MCPServer[]
        +connections: any[]
        +loading: boolean
        +loadServers() Promise
        +loadConnections() Promise
        +connectServer(name) Promise
        +callTool(server, tool, args) Promise
    }

    class A2uiStore {
        +componentTypes: any[]
        +templates: any[]
        +currentSchema: A2UISchema | null
        +loadCatalog() Promise
        +loadTemplates() Promise
        +setSchema(schema) void
    }

    class UseChatStream {
        +streamSSE(fetchFn, onEvent) Promise
    }

    class A2UIRenderer {
        +componentMap: Record~string, FC~
        +render(schema) JSX
    }

    ChatStore ..> UseChatStream : uses
    ChatStore ..> ChatMessage : manages
    AuthStore ..> User : manages
    ChatStore ..> Conversation : manages
    KnowledgeStore ..> Document : manages
    KnowledgeStore ..> RetrievalResult : manages
    SkillStore ..> SkillMetadata : manages
    A2uiStore ..> A2UISchema : manages
    A2UIRenderer ..> A2UISchema : renders
