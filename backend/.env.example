# === 应用配置 ===
APP_NAME=观心 v2
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# === 安全配置 ===
# 签名密钥。留空则服务首次启动时自动生成随机密钥，并持久化到
# <数据目录>/.secret_key（推荐）。若要显式配置，请使用足够长的随机值，
# 且不得提交到版本库。非 development/test 环境下使用内置默认值会拒绝启动。
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === 数据库 ===
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_PATH=./data/guanxin.db
CHECKPOINT_DATABASE_PATH=./data/guanxin-checkpoints.db

# Deep Research 使用 DeepSeek Responses API 的内置 Web Search
RESEARCH_MODEL=deepseek-v4-flash
# 仅允许管理员信任的原文来源域名（精确匹配，不包含子域）
RESEARCH_SOURCE_HOSTS=docs.langchain.com,reference.langchain.com,api-docs.deepseek.com

# === LLM 配置（DeepSeek OpenAI 兼容接口）===
# 真实密钥只写入 backend/.env，禁止写入或提交此模板。
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# === Embedding 配置（本地 Ollama）===
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIMENSION=1024

# 仅 EMBEDDING_PROVIDER=openai 时使用
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=

# === 文件上传 ===
UPLOAD_DIR=./data/uploads
USER_DATA_PATH=./data/users.json
MAX_UPLOAD_SIZE_MB=20

# === CORS ===
CORS_ORIGINS=http://localhost:3000
